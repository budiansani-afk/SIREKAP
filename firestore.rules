rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email != null);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checking if user has special roles by looking up their user document
    // We fetch user info based on their auth email or uid
    function getUserData() {
      return get(/databases/$(database)/documents/sibiru_pengguna/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'admin@sirekap.com' || 
        request.auth.token.email == 'budiansani@gmail.com' || 
        (exists(/databases/$(database)/documents/sibiru_pengguna/$(request.auth.token.email)) && 
         getUserData().role == 'Administrator')
      );
    }

    function isOperator() {
      return isVerified() && (
        request.auth.token.email == 'operator@sirekap.com' || 
        request.auth.token.email == 'budiansani@gmail.com' || 
        (exists(/databases/$(database)/documents/sibiru_pengguna/$(request.auth.token.email)) && 
         (getUserData().role == 'Operator' || getUserData().role == 'Administrator'))
      );
    }

    // Rules for sibiru_program
    match /sibiru_program/{id} {
      allow read: if isVerified();
      allow create: if isAdmin() && isValidId(id) && 
        incoming().kode_program is string && incoming().kode_program.size() <= 32 &&
        incoming().nama_program is string && incoming().nama_program.size() <= 256;
      allow update: if isOperator() && 
        incoming().nama_program is string && incoming().nama_program.size() <= 256;
      allow delete: if isOperator();
    }

    // Rules for sibiru_kegiatan
    match /sibiru_kegiatan/{id} {
      allow read: if isVerified();
      allow create: if isAdmin() && isValidId(id) &&
        incoming().kode_kegiatan is string && incoming().kode_kegiatan.size() <= 32 &&
        incoming().nama_kegiatan is string && incoming().nama_kegiatan.size() <= 256 &&
        exists(/databases/$(database)/documents/sibiru_program/$(incoming().kode_program));
      allow update: if isOperator() &&
        incoming().nama_kegiatan is string && incoming().nama_kegiatan.size() <= 256;
      allow delete: if isOperator();
    }

    // Rules for sibiru_sub_kegiatan
    match /sibiru_sub_kegiatan/{id} {
      allow read: if isVerified();
      allow create: if isAdmin() && isValidId(id) &&
        incoming().kode_sub_kegiatan is string && incoming().kode_sub_kegiatan.size() <= 32 &&
        incoming().nama_sub_kegiatan is string && incoming().nama_sub_kegiatan.size() <= 256 &&
        exists(/databases/$(database)/documents/sibiru_kegiatan/$(incoming().kode_kegiatan));
      allow update: if isOperator() &&
        incoming().nama_sub_kegiatan is string && incoming().nama_sub_kegiatan.size() <= 256;
      allow delete: if isOperator();
    }

    // Rules for sibiru_rka
    match /sibiru_rka/{id} {
      allow read: if isVerified();
      allow create: if isOperator() && isValidId(id) &&
        incoming().uraian_belanja is string && incoming().uraian_belanja.size() <= 500 &&
        incoming().jumlah is number && incoming().jumlah >= 0 &&
        exists(/databases/$(database)/documents/sibiru_sub_kegiatan/$(incoming().kode_sub_kegiatan));
      allow update: if isOperator() &&
        incoming().uraian_belanja is string && incoming().uraian_belanja.size() <= 500 &&
        incoming().jumlah is number && incoming().jumlah >= 0;
      allow delete: if isOperator();
    }

    // Rules for sibiru_realisasi
    match /sibiru_realisasi/{id} {
      allow read: if isVerified();
      allow create: if isOperator() && isValidId(id) &&
        incoming().uraian_belanja is string && incoming().uraian_belanja.size() <= 500 &&
        incoming().nominal_realisasi is number && incoming().nominal_realisasi >= 0 &&
        exists(/databases/$(database)/documents/sibiru_sub_kegiatan/$(incoming().kode_sub_kegiatan));
      allow update: if isOperator() &&
        incoming().uraian_belanja is string && incoming().uraian_belanja.size() <= 500 &&
        incoming().nominal_realisasi is number && incoming().nominal_realisasi >= 0;
      allow delete: if isOperator();
    }

    // Rules for sibiru_monitoring_fisik
    match /sibiru_monitoring_fisik/{id} {
      allow read: if isVerified();
      allow create: if isOperator() && isValidId(id) &&
        incoming().target_fisik is number && incoming().realisasi_fisik is number &&
        exists(/databases/$(database)/documents/sibiru_sub_kegiatan/$(incoming().kode_sub_kegiatan));
      allow update: if isOperator() &&
        incoming().target_fisik is number && incoming().realisasi_fisik is number;
      allow delete: if isOperator();
    }

    // Rules for sibiru_dokumen
    match /sibiru_dokumen/{id} {
      allow read: if isVerified();
      allow create: if isOperator() && isValidId(id) &&
        incoming().nama_dokumen is string && incoming().nama_dokumen.size() <= 256 &&
        incoming().kategori is string && incoming().kategori.size() <= 64;
      allow update: if isOperator() &&
        incoming().nama_dokumen is string && incoming().nama_dokumen.size() <= 256;
      allow delete: if isOperator();
    }

    // Rules for sibiru_pengguna
    match /sibiru_pengguna/{id} {
      // Users can read profile data, Admins can write
      allow read: if isVerified();
      allow write: if isAdmin() || (isVerified() && request.auth.token.email == id);
    }

    // Rules for sibiru_log_aktivitas
    match /sibiru_log_aktivitas/{id} {
      // Anyone signed in can search logs or log their actions
      allow read: if isVerified();
      allow create: if isVerified() && incoming().nama_pengguna == request.auth.token.email;
      allow update, delete: if false; // Audit logs are immutable
    }

    // Rules for sibiru_visits
    match /sibiru_visits/{id} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(id);
      allow update, delete: if false;
    }

    // Rules for sibiru_presence
    match /sibiru_presence/{id} {
      allow read: if isVerified();
      allow create, update: if isVerified() && isValidId(id);
      allow delete: if isVerified() && isValidId(id);
    }

    // Rules for sibiru_pengaturan
    match /sibiru_pengaturan/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
  }
}
