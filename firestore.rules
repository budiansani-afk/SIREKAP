rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 512;
    }

    // Rules for sibiru_program
    match /sibiru_program/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_kegiatan
    match /sibiru_kegiatan/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_sub_kegiatan
    match /sibiru_sub_kegiatan/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_rka
    match /sibiru_rka/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_realisasi
    match /sibiru_realisasi/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_belanja_pihak_ketiga
    match /sibiru_belanja_pihak_ketiga/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for legacy sibiru_monitoring_fisik
    match /sibiru_monitoring_fisik/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_dokumen
    match /sibiru_dokumen/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_pengguna (read permitted so login screen can auto-fill registered user names)
    match /sibiru_pengguna/{id} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_log_aktivitas (Immutable audit logs)
    match /sibiru_log_aktivitas/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update, delete: if false;
    }

    // Rules for sibiru_visits
    match /sibiru_visits/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update, delete: if false;
    }

    // Rules for sibiru_presence
    match /sibiru_presence/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    // Rules for sibiru_pengaturan
    match /sibiru_pengaturan/{id} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(id);
    }
  }
}
